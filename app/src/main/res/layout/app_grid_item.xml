<!--
  Grid cell for the Apps screen (original BaldPhone style), used when Prefs.isAppsGridLayout is on.
  View IDs match app_list_item.xml so AppsListAdapter / AppsActivity can treat both the same.
  The icon takes the full cell width (square) and the cell grows downward for the label,
  so large system font sizes make the cell taller instead of shrinking the icon.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/bg_ripple_row"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_default_app_icon" />

    <ImageView
        android:id="@+id/pin"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/pin_background"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/app_icon"
        app:layout_constraintTop_toTopOf="@id/app_icon"
        app:srcCompat="@drawable/pin_on_button"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/app_name"
        style="@style/BackgroundText.Medium.Plus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center_horizontal"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_icon"
        tools:text="Application Name" />

</androidx.constraintlayout.widget.ConstraintLayout>
