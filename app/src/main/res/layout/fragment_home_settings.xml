<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <app.baldphone.neo.settings.views.SettingsSwitchButtonView
        android:id="@+id/bt_custom_phone_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:switchDescriptionOff="@string/settings_home_phone_number_desc_off"
        app:switchDescriptionOn="@string/settings_home_phone_number_desc_on"
        app:switchTitle="@string/settings_home_phone_number_title" />

    <app.baldphone.neo.settings.views.SettingsSwitchButtonView
        android:id="@+id/bt_four_rows_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:switchDescriptionOff="@string/settings_home_four_rows_desc_off"
        app:switchDescriptionOn="@string/settings_home_four_rows_desc_on"
        app:switchTitle="@string/settings_home_four_rows_title" />

    <app.baldphone.neo.settings.views.SettingsSwitchButtonView
        android:id="@+id/bt_apps_grid_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:switchDescriptionOff="@string/settings_apps_grid_desc_off"
        app:switchDescriptionOn="@string/settings_apps_grid_desc_on"
        app:switchTitle="@string/settings_apps_grid_title" />

</LinearLayout>

</ScrollView>
