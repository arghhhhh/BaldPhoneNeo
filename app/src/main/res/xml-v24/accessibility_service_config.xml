<!--
    Fork: window content + events are enabled ONLY for the Google app (packageNames), so the
    service can press "Gemini Live" right after the Assistant button is tapped (see GeminiLive.kt).
    It acts only within a few seconds of that tap and ignores everything else.
    Keep in sync with res/xml/accessibility_service_config.xml (this v24 file wins on Android 7+).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description_fork"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.googlequicksearchbox" />

    <!--
        Restore if Android disables the accessibility connection with no reason.
        android:accessibilityEventTypes="typeViewClicked|typeWindowStateChanged"
    -->
